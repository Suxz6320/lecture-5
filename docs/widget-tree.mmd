flowchart TD
    ENTRY["main()：runApp(const MyApp())<br/>挂载根 Widget，框架随后接管渲染<br/>〔入口函数，不是 Widget〕"]:::entry

    ENTRY --> APP["MyApp<br/>〔自写〕StatelessWidget"]:::ownSt

    APP --> MAT["MaterialApp<br/>〔内置〕StatefulWidget<br/>title: 'Flutter Demo'"]:::fwSt
    MAT -. "theme ★改造二" .-> THEME["主题：ThemeData(<br/>colorScheme: ColorScheme.fromSeed(seedColor: Colors.teal),<br/>useMaterial3: true)<br/>模板默认是 Colors.deepPurple"]:::cfg
    MAT --> HOME["home：MyHomePage(title: 'Flutter Demo Home Page')<br/>〔自写〕StatefulWidget"]:::ownSf

    HOME --> ST["_MyHomePageState（State 的子类，非 Widget 本身）<br/>int _counter = 0<br/>★改造一：int _step = 1<br/>★改造三：每个钩子 print 一行"]:::state
    ST -. "★改造三：生命周期日志" .-> LC["initState → didChangeDependencies → build<br/>→ didUpdateWidget → dispose"]:::cfg

    ST -->|"build(context) 返回"| SCA["Scaffold<br/>〔内置〕StatefulWidget<br/>页面骨架：appBar / body / floatingActionButton"]:::fwSf
    SCA -. "本案未使用" .-> UNUSED["bottomNavigationBar / drawer<br/>Scaffold 的其它插槽"]:::cfg

    SCA --> BAR["appBar：AppBar<br/>〔内置〕StatefulWidget<br/>backgroundColor: Theme.of(context).colorScheme.inversePrimary ← 取主题 ①"]:::fwSf
    BAR --> BT["title：Text(widget.title)<br/>〔内置〕StatelessWidget"]:::fwSt
    BAR -. "actions ★改造一" .-> STEP["PopupMenuButton（步长 1 / 2 / 5）<br/>〔内置〕StatefulWidget"]:::fwSf
    BAR -. "flexibleSpace ★改造三" .-> IMG["Image.asset('assets/images/banner.png')<br/>〔内置〕StatelessWidget<br/>资源需在 pubspec.yaml 的 assets 段声明"]:::fwSt

    SCA --> CENTER["body：Center<br/>布局 / 渲染类（无内部可变状态）"]:::ro
    CENTER --> COL["Column<br/>布局 / 渲染类"]:::ro
    COL --> T1["Text('You have pushed the button this many times:')<br/>〔内置〕StatelessWidget"]:::fwSt
    COL --> T2["Text('$_counter', style: Theme.of(context).textTheme.headlineMedium)<br/>〔内置〕StatelessWidget<br/>★改造二：取主题 ②"]:::fwSt
    COL -. "★改造一 新增" .-> T3["Text('步长：$_step')<br/>〔内置〕StatelessWidget"]:::fwSt

    SCA --> FAB["floatingActionButton：FloatingActionButton<br/>〔内置〕StatelessWidget<br/>onPressed: _incrementCounter"]:::fwSt
    FAB --> ICON["child：Icon(Icons.add)<br/>〔内置〕StatelessWidget"]:::fwSt
    FAB -. "点击后" .-> ACT["_counter += _step<br/>→ setState()：标记 dirty → 下一帧重建<br/>（改样式按 r，改 initState 逻辑按 R）"]:::cfg

